# ---------------------------------------------------------------------------
# DCRGPI - Debating Club of Rangpur Government Polytechnic Institute
# Environment configuration
# Copy to .env.local and fill in real values. Never commit .env.local.
# ---------------------------------------------------------------------------

# MongoDB Atlas connection string
MONGODB_URI=

# Secret used to sign admin session cookies (min 32 random characters)
AUTH_SECRET=

# Public base URL of the site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Seed administrator (used only by `npm run seed`)
ADMIN_NAME=Club Administrator
ADMIN_EMAIL=dcrgpi.info@gmail.com
ADMIN_PASSWORD=

# Cloudinary (image uploads). Without these the admin panel accepts image URLs.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional Google OAuth credentials (reserved for future SSO)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
